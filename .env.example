# Local settings. Copy to .env (gitignored) and edit: cp .env.example .env
# Read by the Makefile (exported to every target) and by docker compose (`make up`).
# Everything here has the same default in the code, so a missing .env still works.
# Plain KEY=value lines only: no quotes, no spaces around `=` (the Makefile includes this file).

# --- Gemini (the agent, `make ask`). Free-tier keys only have quota on Flash models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Postgres (docker compose)
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=warehouse
POSTGRES_PORT=5433
# Read-only role for Metabase and the agent. Set when the database volume is first created.
ANALYST_PASSWORD=analyst

# --- Host ports of the other services
METABASE_PORT=3000
AIRFLOW_PORT=8080

# --- Connections from the host (derived from the values above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
AGENT_DATABASE_URL=postgresql://analyst:${ANALYST_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DBT_HOST=localhost
DBT_PORT=${POSTGRES_PORT}
DBT_USER=${POSTGRES_USER}
DBT_PASSWORD=${POSTGRES_PASSWORD}
DBT_DBNAME=${POSTGRES_DB}

# --- Metabase admin created by `make dashboard` (local dev account)
MB_URL=http://localhost:${METABASE_PORT}
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=receipts-local-2026
